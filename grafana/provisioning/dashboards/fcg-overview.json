{
  "title": "FCG Platform — Overview",
  "uid": "fcg-overview",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "HTTP Requests / segundo",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_received_total[1m]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latência P99 por serviço (ms)",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000",
          "legendFormat": "{{job}} p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Taxa de Erros 5xx por serviço",
      "type": "timeseries",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_received_total{code=~\"5..\"}[1m]))",
          "legendFormat": "{{job}} 5xx"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests em andamento",
      "type": "stat",
      "datasource": "Prometheus",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (job) (http_requests_in_progress)",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ],
  "time": { "from": "now-30m", "to": "now" },
  "timepicker": {}
}
